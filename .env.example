# 應用讀取的環境變數清單。這份進版控，實際被讀的檔案不進版控：
# 本機是 .env.local（make dev 缺檔時自動從這裡複製），目標主機是自備的 .env.<env>。
# 新增變數先加在這裡；機密只列 key 與 placeholder，真正的值填在不進版控的那份。

# 本機叫 local，與部署出去的 dev environment 區分：頁面顯示 local 就是你本機
APP_ENV=local

# debug | info | warning | error（小寫）
LOG_LEVEL=debug

# 只有 make deploy 會用到：frontend 對外埠。make dev 固定綁 3000。
HTTP_PORT=3000

# 機密範例（模板目前沒有）：
# DATABASE_URL=postgresql://user:changeme@db:5432/app
